{
  "name": "@algoritm-lab/backend",
  "version": "1.0.0",
  "private": true,
  "description": "container launch commands ```#bash docker compose -f ./docker-compose.yml up -d ```",
  "main": "index.js",
  "scripts": {
    "preinstall": "node ../../scripts/enforce-root-install.mjs",
    "test": "echo \"Error: no test specified\" && exit 1",
    "typeorm": "TS_NODE_PROJECT=./tsconfig.json ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d ./ormconfig.ts",
    "mi:c": "sh -c 'typeorm migration:create ./type-orm/migrations/${0}'",
    "mi:show": "pnpm run typeorm -- migration:show",
    "mi:run": "pnpm run typeorm migration:run",
    "mi:revert": "pnpm run typeorm -- migration:revert",
    "build": "nest build",
    "lint": "eslint . --ext .ts,.js --fix",
    "start": "nest start",
    "start:dev": "nest start --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Drotyk/algoritm-lab.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Drotyk/algoritm-lab/issues"
  },
  "homepage": "https://github.com/Drotyk/algoritm-lab#readme",
  "dependencies": {
    "@nestjs/common": "^11.1.18",
    "@nestjs/core": "^11.1.18",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.18",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/typeorm": "^11.0.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "^17.2.3",
    "ms": "^2.1.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-themes": "^1.4.3",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^0.3.28",
    "typeorm-naming-strategies": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@nestjs/cli": "^11.0.17",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^25.5.2",
    "@types/passport-jwt": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "eslint": "^9.24.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-unicorn": "^57.0.0",
    "globals": "^16.5.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.2"
  }
}
