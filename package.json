{
  "name": "algoritm-lab",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "start:dev": "pnpm -r start:dev",
    "preinstall": "node ./scripts/enforce-root-install.mjs",
    "docker:up": "docker compose -f ./docker-compose.yml up -d",
    "docker:down": "docker compose --env-file ./.env -f ./docker-compose.yml down --remove-orphans",
    "install:root": "pnpm install",
    "frontend:build": "pnpm --filter @algoritm-lab/frontend run build",
    "frontend:start": "pnpm --filter @algoritm-lab/frontend run start:dev",
    "backend:build": "pnpm --filter @algoritm-lab/backend run build",
    "backend:lint": "pnpm --filter @algoritm-lab/backend run lint",
    "backend:start": "pnpm --filter @algoritm-lab/backend run start",
    "backend:start:dev": "pnpm --filter @algoritm-lab/backend run start:dev",
    "backend:mi:show": "pnpm --filter @algoritm-lab/backend run mi:show",
    "backend:mi:run": "pnpm --filter @algoritm-lab/backend run mi:run",
    "backend:mi:revert": "pnpm --filter @algoritm-lab/backend run mi:revert"
  }
}
